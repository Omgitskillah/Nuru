# Which provider deep-think's tools dispatch to.
DEEP_THINK_PROVIDER=claude

# Real Anthropic API key - required for the claude provider to actually
# reach the live API. Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-...

# Base directory that a relative ask_an_expert file_path is resolved against.
# nuru passes vault-relative paths, so this must be the vault root.
DEEP_THINK_BASE_DIR=/absolute/path/to/vault
