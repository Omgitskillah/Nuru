# python-4-llms (run_python): the Docker CLI, its local socket, and the sandbox image's full ID.
# Without this file (or with Docker not running) Nuru starts without run_python.
# Build the image as servers/python-4-llms/README.md shows, then put its `image inspect --format '{{.Id}}'` here.
PYTHON_MCP_DOCKER=/Applications/Docker.app/Contents/Resources/bin/docker
PYTHON_MCP_DOCKER_SOCKET=/Users/YOU/.docker/run/docker.sock
PYTHON_MCP_IMAGE=sha256:REPLACE_WITH_64_HEX_DIGITS
