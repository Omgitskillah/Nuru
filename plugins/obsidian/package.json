{
  "name": "nuru-obsidian",
  "version": "1.0.4",
  "private": true,
  "description": "Nuru's Obsidian plugin (WP01).",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "test:coverage": "node --test --test-timeout=60000 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.js",
    "test:e2e": "node --test --test-timeout=60000 test/e2e/*.test.js",
    "build": "node build.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2"
  },
  "allowScripts": {
    "esbuild": false
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  }
}
