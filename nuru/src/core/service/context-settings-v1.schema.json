{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "operation",
        "expected_revision"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation": {
          "enum": [
            "measure",
            "apply"
          ]
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^(initial|[0-9a-f]{32})$"
        },
        "gb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "apply"
              }
            }
          },
          "then": {
            "required": [
              "gb"
            ]
          },
          "else": {
            "not": {
              "required": [
                "gb"
              ]
            }
          }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "revision",
        "window_tokens",
        "measured",
        "can_measure",
        "busy"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^(initial|[0-9a-f]{32})$"
        },
        "window_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "measured": {
          "type": "boolean"
        },
        "can_measure": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "notice": {
          "type": "string",
          "maxLength": 1000
        },
        "limit_reason": {
          "type": "string",
          "maxLength": 1000
        },
        "gb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "min_gb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_gb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "bytes_per_token": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1073741824
        },
        "needs_apply": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measured": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "gb",
              "min_gb",
              "max_gb",
              "max_tokens",
              "bytes_per_token"
            ]
          }
        }
      ]
    }
  }
}
