{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuru.local/capture/v1",
  "title": "WP02 capture contract, version 1",
  "$defs": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "content": {"type": "string", "minLength": 1},
    "uid": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "legacy_request": {
      "type": "object", "additionalProperties": false, "required": ["content"],
      "properties": {"content": {"$ref": "#/$defs/content"}}
    },
    "idempotent_request": {
      "type": "object", "additionalProperties": false, "required": ["request_id", "content"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "content": {"$ref": "#/$defs/content"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["ok", "uid", "path", "revision"],
      "properties": {
        "ok": {"const": true},
        "uid": {"$ref": "#/$defs/uid"},
        "path": {"type": "string", "pattern": "^Inbox/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.md$"},
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "accepted_capture": {
      "type": "object", "additionalProperties": false, "required": ["v", "request_id", "state", "status"],
      "properties": {
        "v": {"const": 1},
        "request_id": {"$ref": "#/$defs/request_id"},
        "state": {"enum": ["accepted", "running", "uncertain"]},
        "status": {"type": "string", "pattern": "^/v1/captures/requests/[A-Za-z0-9_-]{16,128}$"}
      }
    },
    "capture_error": {
      "type": "object", "additionalProperties": false, "required": ["ok", "error"],
      "properties": {
        "ok": {"const": false},
        "error": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "capture_status": {
      "type": "object", "additionalProperties": false, "required": ["v", "request_id", "state"],
      "properties": {
        "v": {"const": 1},
        "request_id": {"$ref": "#/$defs/request_id"},
        "state": {"enum": ["accepted", "running", "completed", "uncertain", "gone"]},
        "receipt": {"$ref": "#/$defs/receipt"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "completed"}}}, "then": {"required": ["receipt"]}},
        {"if": {"properties": {"state": {"enum": ["accepted", "running", "uncertain", "gone"]}}},
         "then": {"not": {"required": ["receipt"]}}}
      ]
    }
  }
}
