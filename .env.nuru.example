# The model Nuru runs. Its family's Modelfile (nuru/modelfiles/<family>.Modelfile) and profile
# (nuru/modelfiles/profiles.yaml) come with it: the system prompt, sampling, and how much it thinks.
NURU_BASE_MODEL=granite4.2:3b
# NURU_BASE_MODEL=qwen3.5:4b
MODEL=nuru
# Claude as the main model instead (claude-haiku-5-5 or claude-sonnet-5-5); unset or "ollama" keeps the
# local model above. Uses CLAUDE_API_KEY from .env.deep-think. Everything the model reads is sent to the API.
# NURU_MAIN_MODEL=anthropic:claude-haiku-5-5
# How long Ollama keeps the local model loaded after each request: "30m", "600" (seconds), or "-1"
# (until Ollama stops). Unset: 30 minutes. Longer means fewer slow cold starts after a pause, and the
# model's memory stays held for that long; "5m" is Ollama's own default.
# NURU_KEEP_ALIVE=30m

# Optional model-free link bookkeeping; off unless explicitly set to 1.
NURU_LINK_AUDIT=0
NURU_LINK_AUDIT_INTERVAL=30
# Optional deterministic stewardship; selected packages come from explicit JSON.
NURU_STEWARD_ENABLED=0
NURU_STEWARD_INTERVAL=30
# NURU_STEWARD_STATE=/absolute/path/to/vault/.obsidian-mcp-steward.sqlite3
# Configure OBSIDIAN_LINK_POLICY in .env.obsidian; see nuru/evals/vault_steward/README.md.
