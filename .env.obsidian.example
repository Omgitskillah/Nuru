VAULT_PATH=/absolute/path/to/vault

# Semantic search (optional; these are the defaults)
# OBSIDIAN_EMBED_MODEL=nomic-embed-text:v1.5
# OBSIDIAN_CHUNK_CHARS=1500
# OBSIDIAN_SEMANTIC_DB=/absolute/path/to/vault/.obsidian-mcp-semantic.sqlite3
# OLLAMA_HOST=http://localhost:11434

# Optional read-only link audit policy; no model required.
# OBSIDIAN_LINK_POLICY=/absolute/path/to/link-policy.json
# OBSIDIAN_STEWARD_CONFIG=/absolute/path/to/steward-config.json
# Reproducible index identity and bounded embedding requests (optional).
# OBSIDIAN_EMBED_DIGEST=sha256-digest-from-ollama-tags
# OBSIDIAN_INDEX_PARSER_VERSION=1
# OBSIDIAN_INDEX_EXCLUSIONS=["Maintenance"]
# OBSIDIAN_EMBED_BATCH_CHUNKS=16
